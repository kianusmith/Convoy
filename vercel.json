{
  "version": 2,
  "functions": {
    "api/webhooks/stripe.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/create", "destination": "/create/index.html" },
    { "source": "/pay/:slug", "destination": "/pay/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
